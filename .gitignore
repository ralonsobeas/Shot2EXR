# ---- Python ----
__pycache__/
*.py[cod]
*$py.class
*.so
*.egg
*.egg-info/
.eggs/
pip-wheel-metadata/
.installed.cfg

# ---- Environments (conda / venv) ----
.venv/
venv/
env/
.conda/
envs/
.python-version
.env
.env.*

# ---- Build and packaging (PyInstaller etc.) ----
build/
dist/
*.spec
!packaging/shot2exr.spec
*.manifest
*.exe
*.msi
*.AppImage

# ---- Test / tool caches ----
.pytest_cache/
.coverage
